[Unit]
Description=PiCloud — Private Cloud for Raspberry Pi Clusters
Documentation=https://github.com/Hafeok/picloud
After=network-online.target avahi-daemon.service
Wants=network-online.target

[Service]
Type=simple
User=admin
Group=admin

ExecStart=/usr/local/bin/picloud-server
ExecStartPost=/bin/sh -c 'sleep 3 && curl -sf http://localhost:7443/health || exit 1'

# Restart policy — always restart on failure, back off on repeated failures
Restart=on-failure
RestartSec=5s
StartLimitInterval=60s
StartLimitBurst=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=picloud

# Environment
Environment=RUST_LOG=picloud=info,warn
Environment=PICLOUD_DOMAIN=picloud.local
Environment=PICLOUD_DATA_ROOT=/var/lib/picloud
Environment=PICLOUD_HTTP_PORT=7443
Environment=PICLOUD_BIND_ADDR=0.0.0.0

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Capabilities — needed for DNS on port 53
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/picloud
PrivateTmp=true

[Install]
WantedBy=multi-user.target
